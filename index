/* Router */
function parseHash(){
  const h=location.hash.replace(/^#/,"")||"/";
  const [path,qs]=h.split("?");
  const parts=path.split("/").filter(Boolean);
  const params={};
  if(qs) qs.split("&").forEach(pair=>{const [k,v]=pair.split("=");params[decodeURIComponent(k)]=decodeURIComponent(v||"")});
  return {parts,params};
}

function renderRoute(){
  const {parts,params}=parseHash();
  const main=document.getElementById("main");
  let html="";
  const route=parts[0]||"home";

  if(route==="home") html=views.home();
  else if(route==="specialities") html=views.specialities();
  else if(route==="doctors") html=views.doctors();
  else if(route==="doctor"&&parts[1]) html=views.doctor(parts[1]);
  else if(route==="book"&&parts[1]) html=views.book(parts[1]);
  else if(route==="hospitals") html=views.hospitals();
  else if(route==="labs") html=views.labs();
  else if(route==="online") html=views.online();
  else if(route==="articles") html=views.articles();
  else if(route==="article"&&parts[1]) html=views.article(parts[1]);
  else if(route==="about") html=views.about();
  else if(route==="contact") html=views.contact();
  else if(route==="company") html=views.company();
  else if(route==="help") html=views.help();
  else if(route==="privacy") html=views.privacy();
  else if(route==="terms") html=views.terms();
  else if(route==="refund") html=views.refund();
  else if(route==="faq") html=views.faq();
  else if(route==="careers") html=views.careers();
  else if(route==="press") html=views.press();
  else if(route==="dashboard") html=views.dashboard();
  else if(route==="login") html=views.login();
  else if(route==="doctor-signup") html=views.doctorSignup();
  else html=views.notFound();

  main.innerHTML=html;
  applyStaticTranslations();

  $$(".main-nav .nav__link, .bottom-nav a").forEach(a=>{
    const href=a.getAttribute("href")||"";
    const isActive=href==="#/"+route||(route==="home"&&href==="#/");
    a.classList.toggle("active",isActive);
    if(isActive) a.setAttribute("aria-current","page"); else a.removeAttribute("aria-current");
  });

  const cartBtn=document.getElementById("cartBtn");
  if(cartBtn) cartBtn.style.display=(route==="labs"||store.get("cart",[]).length)?"inline-flex":"none";

  requestAnimationFrame(()=>{
    initReveal();
    initCounters();
    wirePageHandlers(route,parts,params);
  });

  window.scrollTo({top:0,behavior:"auto"});
}

