}

function wireTools(){
  $$("[data-calc]").forEach(btn=>{
    if(btn.dataset.wired) return;
    btn.dataset.wired="1";
    btn.onclick=()=>{
      const type=btn.dataset.calc;
      const result=document.querySelector('[data-result="'+type+'"]');
      if(!result) return;
      let html="";
      if(type==="bmi"){
        const h=+$("#bmi-h").value/100,w=+$("#bmi-w").value;
        if(!h||!w){toast(t('t_missing'),LANG==='ur'?'قد اور وزن درج کریں':'Enter height and weight',"error");return}
        const bmi=w/(h*h);
        const cat=bmi<18.5?(LANG==='ur'?'کم وزن':'Underweight'):bmi<25?(LANG==='ur'?'نارمل':'Normal'):bmi<30?(LANG==='ur'?'زیادہ وزن':'Overweight'):(LANG==='ur'?'موٹاپا':'Obese');
        html="<p>"+(LANG==='ur'?'آپ کا BMI':'Your BMI')+"</p><b>"+bmi.toFixed(1)+"</b><p class='small mt-2'>"+(LANG==='ur'?'درجہ بندی: ':'Category: ')+"<strong>"+cat+"</strong></p>";
      }
      if(type==="bmr"){
        const age=+$("#bmr-a").value,g=$("#bmr-g").value,h=+$("#bmr-h").value,w=+$("#bmr-w").value;
        if(!age||!h||!w){toast(t('t_missing'),LANG==='ur'?'تمام فیلڈز بھریں':'Fill all fields',"error");return}
        const isMale = (g===t('male')||g==='Male');
        const bmr=isMale?10*w+6.25*h-5*age+5:10*w+6.25*h-5*age-161;
        html="<p>"+(LANG==='ur'?'روزانہ کیلوری کی ضرورت (بیٹھے رہنے والا)':'Daily calorie needs (sedentary)')+"</p><b>"+Math.round(bmr*1.2)+" kcal</b>";
      }
      if(type==="preg"){
        const v=$("#preg-lmp").value;
        if(!v){toast(t('t_missing'),LANG==='ur'?'آخری ماہواری کی تاریخ منتخب کریں':'Select your last period date',"error");return}
        const due=new Date(v);due.setDate(due.getDate()+280);
        html="<p>"+(LANG==='ur'?'متوقع تاریخ پیدائش':'Estimated due date')+"</p><b>"+due.toLocaleDateString(LANG==='ur'?'ur-PK':'en-PK',{day:"numeric",month:"long",year:"numeric"})+"</b>";
      }
      if(type==="bp"){
        const s=+$("#bp-s").value,d=+$("#bp-d").value;
        if(!s||!d){toast(t('t_missing'),LANG==='ur'?'دونوں قدریں درج کریں':'Enter both values',"error");return}
        let cat=LANG==='ur'?'نارمل':'Normal',color="var(--accent-hover)";
        if(s>=180||d>=120){cat=LANG==='ur'?'ہائپرٹینسیو بحران — فوری طبی امداد':'Hypertensive Crisis';color="var(--danger)"}
        else if(s>=140||d>=90){cat=LANG==='ur'?'اسٹیج 2 ہائپرٹینشن':'Stage 2 Hypertension';color="var(--danger)"}
        else if(s>=130||d>=80){cat=LANG==='ur'?'اسٹیج 1 ہائپرٹینشن':'Stage 1 Hypertension';color="var(--warning)"}
        else if(s>=120&&d<80){cat=LANG==='ur'?'بلند':'Elevated';color="var(--warning)"}
        html="<p>"+(LANG==='ur'?'درجہ بندی':'Category')+"</p><b style='color:"+color+"'>"+cat+"</b><p class='small mt-2'>"+s+"/"+d+" mmHg</p>";
      }
      result.innerHTML=html;
      result.classList.add("show");
    };
  });
}

function wireDoctorsPage(params){
  const grid=$("#doctorsGrid");if(!grid)return;
  const count=$("#resultCount");
  const empty=$("#emptyState");
  const activeBar=$("#activeBar");
  const loadMore=$("#loadMoreWrap");
  const state={
    city:params.city||"",speciality:params.speciality||"",area:"",hospital:params.hospital||"",
    gender:[],fee:10000,exp:0,rating:0,online:params.online==="1",today:false,
    sort:"relevance",page:1,perPage:8
  };
  const citySel=$("#f-city"),specSel=$("#f-spec"),areaSel=$("#f-area");
  citySel.value=state.city;specSel.value=state.speciality;
  $("#f-online").checked=state.online;
  function refreshAreas(){
    const list=state.city?(SC.CITY_AREAS[state.city]||[]):[];
    areaSel.innerHTML='<option value="">'+t('all_areas')+'</option>'+list.map(a=>'<option>'+a+'</option>').join("");
    areaSel.disabled=!state.city;
  }
  refreshAreas();

  on(citySel,"change",()=>{state.city=citySel.value;state.area="";refreshAreas();state.page=1;render()});
  on(specSel,"change",()=>{state.speciality=specSel.value;state.page=1;render()});
  on(areaSel,"change",()=>{state.area=areaSel.value;state.page=1;render()});
  $$('input[name="gender"]').forEach(cb=>on(cb,"change",()=>{state.gender=$$('input[name="gender"]:checked').map(x=>x.value);state.page=1;render()}));
  $$('input[name="rating"]').forEach(r=>on(r,"change",()=>{state.rating=parseFloat($('input[name="rating"]:checked').value);state.page=1;render()}));
  on($("#f-fee"),"input",e=>{state.fee=+e.target.value;$("#feeVal").textContent=fmtPKR(state.fee);state.page=1;render()});
  on($("#f-exp"),"input",e=>{state.exp=+e.target.value;$("#expVal").textContent=state.exp+" "+t('yrs');state.page=1;render()});
  on($("#f-online"),"change",e=>{state.online=e.target.checked;state.page=1;render()});
  on($("#f-today"),"change",e=>{state.today=e.target.checked;state.page=1;render()});
  on($("#f-sort"),"change",e=>{state.sort=e.target.value;state.page=1;render()});

  function clearAll(){
    state.city=state.speciality=state.area=state.hospital="";
    state.gender=[];state.fee=10000;state.exp=0;state.rating=0;state.online=false;state.today=false;state.page=1;
    citySel.value="";specSel.value="";refreshAreas();
    $$('input[name="gender"]').forEach(c=>c.checked=false);
    const any=$('input[name="rating"][value="0"]'); if(any) any.checked=true;
    $("#f-fee").value=10000;$("#feeVal").textContent="PKR 10,000";
    $("#f-exp").value=0;$("#expVal").textContent="0 "+t('yrs');
    $("#f-online").checked=false;$("#f-today").checked=false;
    render();
  }
  on($("#clearFilters"),"click",clearAll);
  on($("#emptyClearBtn"),"click",clearAll);

  function filterList(){
    let list=SC.DOCTORS.slice();
    if(state.city) list=list.filter(d=>d.city===state.city);
    if(state.speciality) list=list.filter(d=>d.specialityId===state.speciality);
    if(state.hospital) list=list.filter(d=>d.hospitalId===state.hospital);
    if(state.area) list=list.filter(d=>d.area===state.area);
    if(state.gender.length) list=list.filter(d=>state.gender.includes(d.gender));
    list=list.filter(d=>d.fee<=state.fee&&d.experience>=state.exp);
    if(state.rating) list=list.filter(d=>d.rating>=state.rating);
    if(state.online) list=list.filter(d=>d.online);
    if(state.today) list=list.filter(d=>d.availableToday);
    switch(state.sort){
      case "rating":list.sort((a,b)=>b.rating-a.rating);break;
      case "fee-asc":list.sort((a,b)=>a.fee-b.fee);break;
      case "fee-desc":list.sort((a,b)=>b.fee-a.fee);break;
      case "experience":list.sort((a,b)=>b.experience-a.experience);break;
      default:list.sort((a,b)=>(b.rating*b.recommend)-(a.rating*a.recommend));
    }
    return list;
  }
  function renderChips(){
    const chips=[];
    if(state.city) chips.push({label:state.city,clear:()=>{state.city="";citySel.value="";refreshAreas()}});
    if(state.speciality){const sp=SC.SPECIALITIES.find(s=>s.id===state.speciality);if(sp)chips.push({label:specName(sp),clear:()=>{state.speciality="";specSel.value=""}})}
    if(state.hospital){const h=SC.HOSPITALS.find(x=>x.id===state.hospital);if(h)chips.push({label:h.name,clear:()=>{state.hospital=""}})}
    if(state.area) chips.push({label:state.area,clear:()=>{state.area="";areaSel.value=""}});
    state.gender.forEach(g=>chips.push({label:(g==='Male'?t('male'):t('female')),clear:()=>{const cb=$('input[name="gender"][value="'+g+'"]');if(cb)cb.checked=false;state.gender=state.gender.filter(x=>x!==g)}}));
    if(state.fee<10000) chips.push({label:"≤ "+fmtPKR(state.fee),clear:()=>{state.fee=10000;$("#f-fee").value=10000;$("#feeVal").textContent="PKR 10,000"}});
    if(state.exp>0) chips.push({label:state.exp+"+ "+t('yrs'),clear:()=>{state.exp=0;$("#f-exp").value=0;$("#expVal").textContent="0 "+t('yrs')}});
    if(state.rating) chips.push({label:state.rating+"+",clear:()=>{state.rating=0;const r=$('input[name="rating"][value="0"]');if(r)r.checked=true}});
    if(state.online) chips.push({label:t('online_only'),clear:()=>{state.online=false;$("#f-online").checked=false}});
    if(state.today) chips.push({label:t('available_today'),clear:()=>{state.today=false;$("#f-today").checked=false}});
    activeBar.innerHTML=chips.length?chips.map((c,i)=>'<button class="chip chip--active" type="button" data-chip="'+i+'">'+esc(c.label)+' <span class="chip__x">✕</span></button>').join(""):"";
    activeBar.querySelectorAll("[data-chip]").forEach((b,i)=>on(b,"click",()=>{chips[i].clear();state.page=1;render()}));
  }
