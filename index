function wireBookingPage(doctorId){
  const doctor=SC.DOCTORS.find(x=>x.id===doctorId)||SC.DOCTORS[0];
  const state={step:1,type:"In-Clinic",date:null,time:null,patient:{}};
  const steps=$$(".wizard-step");
  const dots=$$("#stepper .step");
  const back=$("#wzBack");
  const next=$("#wzNext");
  const nav=$("#wizardNav");
  if(!next) return;

  function setStep(n){
    state.step=n;
    steps.forEach(s=>s.classList.toggle("hide",+s.dataset.panel!==n));
    dots.forEach(d=>{
      const i=+d.dataset.step;
      d.classList.toggle("active",i===n);
      d.classList.toggle("done",i<n);
    });
    back.disabled=(n===1||n===5);
    next.textContent=n===4?t('confirm_booking'):t('continue');
    nav.classList.toggle("hide",n===5);
    window.scrollTo({top:120,behavior:"smooth"});
  }
  on(back,"click",()=>setStep(Math.max(1,state.step-1)));
  on(next,"click",()=>{
    if(state.step===1){const picked=$('input[name="aptype"]:checked');if(picked)state.type=picked.value;setStep(2);return}
    if(state.step===2){
      const form=$("#patientForm");
      if(!validateForm(form)) return;
      state.patient={name:$("#p-name").value.trim(),age:$("#p-age").value,gender:$("#p-gender").value,phone:$("#p-phone").value.trim(),email:$("#p-email").value.trim(),reason:$("#p-reason").value.trim()};
      setStep(3); return;
    }
    if(state.step===3){
      if(!state.date||!state.time){toast(t('t_missing'),LANG==='ur'?'تاریخ اور وقت منتخب کریں':'Please pick a date and time slot',"error");return}
      renderSummary();
      setStep(4); return;
    }
    if(state.step===4){confirmBooking();setStep(5);return}
  });

  const calGrid=$("#calGrid"),calLabel=$("#calLabel");
  let calMonth=new Date();
  function renderCalendar(){
    if(!calGrid) return;
    const y=calMonth.getFullYear(),m=calMonth.getMonth();
    calLabel.textContent=calMonth.toLocaleString(LANG==='ur'?'ur-PK':'en-PK',{month:"long",year:"numeric"});
    const first=new Date(y,m,1).getDay();
    const days=new Date(y,m+1,0).getDate();
    let html=["S","M","T","W","T","F","S"].map(d=>'<div class="cal__dow">'+d+'</div>').join("");
    for(let i=0;i<first;i++) html+='<div class="cal__day cal__day--empty"></div>';
    const today=new Date();today.setHours(0,0,0,0);
    for(let d=1;d<=days;d++){
      const date=new Date(y,m,d);
      const disabled=date<today;
      const key=date.getFullYear()+"-"+String(date.getMonth()+1).padStart(2,"0")+"-"+String(date.getDate()).padStart(2,"0");
      html+='<button class="cal__day" type="button" '+(disabled?"disabled":"")+' data-date="'+key+'" aria-pressed="'+(state.date===key)+'">'+d+'</button>';
    }
    calGrid.innerHTML=html;
    calGrid.querySelectorAll("[data-date]").forEach(b=>on(b,"click",()=>{
      state.date=b.dataset.date;state.time=null;renderCalendar();renderSlots();
    }));
  }
  on($("#calPrev"),"click",()=>{calMonth.setMonth(calMonth.getMonth()-1);renderCalendar()});
  on($("#calNext"),"click",()=>{calMonth.setMonth(calMonth.getMonth()+1);renderCalendar()});
  renderCalendar();

  function renderSlots(){
    const slotGrid=$("#slotGrid");
    if(!slotGrid) return;
    if(!state.date){slotGrid.innerHTML='<p class="muted small">'+t('select_date')+'</p>';return}
    const allSlots=["09:00","09:30","10:00","10:30","11:00","11:30","12:00","15:00","15:30","16:00","16:30","17:00","18:00","18:30","19:00"];
    const taken=["10:00","11:30","16:30"];
    slotGrid.innerHTML=allSlots.map(tm=>{
      const disabled=taken.includes(tm);
      return '<button class="slot" type="button" '+(disabled?"disabled":"")+' aria-pressed="'+(state.time===tm)+'" data-time="'+tm+'">'+tm+'</button>';
    }).join("");
    slotGrid.querySelectorAll("[data-time]").forEach(b=>on(b,"click",()=>{state.time=b.dataset.time;renderSlots()}));
  }
  renderSlots();

  function renderSummary(){
    const sc=$("#summaryCard");
    if(!sc) return;
    const dstr=state.date?new Date(state.date+"T00:00:00").toLocaleDateString(LANG==='ur'?'ur-PK':'en-PK',{weekday:"short",day:"numeric",month:"short",year:"numeric"}):"—";
    sc.innerHTML='<div class="stack" style="gap:12px">'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'ڈاکٹر':'Doctor')+'</span><b>'+esc(doctor.name)+'</b></div>'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'قسم':'Type')+'</span><b>'+esc(state.type)+'</b></div>'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'تاریخ':'Date')+'</span><b>'+esc(dstr)+'</b></div>'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'وقت':'Time')+'</span><b>'+esc(state.time||"—")+'</b></div>'+
      '<hr class="divider"/>'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'مریض':'Patient')+'</span><b>'+esc(state.patient.name||"—")+'</b></div>'+
      '<div class="row--between row"><span class="muted small">'+(LANG==='ur'?'فون':'Phone')+'</span><b>'+esc(state.patient.phone||"—")+'</b></div>'+
      '<hr class="divider"/>'+
      '<div class="row--between row" style="font-size:1.125rem"><b>'+t('cart_total')+'</b><b>'+fmtPKR(doctor.fee)+'</b></div>'+
    '</div>';
  }
  function confirmBooking(){
    const id="SC"+Date.now().toString().slice(-8);
    const el=$("#bookingId");
    if(el) el.textContent=id;
    toast(t('t_booked'),t('t_booked_d')+id,"success");
  }
  on($("#addToCal"),"click",()=>{
    if(!state.date||!state.time){toast(t('t_missing'),LANG==='ur'?'کوئی سلاٹ منتخب نہیں':'No slot selected',"error");return}
    const dt=new Date(state.date+"T"+state.time+":00");
    const end=new Date(dt.getTime()+30*60000);
    const fmt=d=>d.toISOString().replace(/[-:]/g,"").split(".")[0]+"Z";
    const ics=["BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//SehatConnect//EN","BEGIN:VEVENT",
      "UID:"+Date.now()+"@sehatconnect.pk","DTSTAMP:"+fmt(new Date()),
      "DTSTART:"+fmt(dt),"DTEND:"+fmt(end),
      "SUMMARY:Appointment with "+doctor.name,
      "DESCRIPTION:"+doctor.speciality+" — "+state.type,
      "LOCATION:"+doctor.hospital+", "+doctor.city,
      "END:VEVENT","END:VCALENDAR"].join("\r\n");
    const blob=new Blob([ics],{type:"text/calendar"});
    const a=document.createElement("a");
    a.href=URL.createObjectURL(blob);a.download="sehatconnect-appointment.ics";
    document.body.appendChild(a);a.click();document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
    toast(t('t_download'),t('t_download_d'),"success");
  });
}

