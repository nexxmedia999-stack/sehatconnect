function initAutocomplete(){
  const input=$("#headerSearch");
  const box=$("#headerAC");
  if(!input||!box) return;
  const items=[];
  SC.DOCTORS.forEach(d=>items.push({type:LANG==='ur'?'ڈاکٹر':'Doctor',label:d.name,sub:d.speciality+" · "+d.city,href:"#/doctor/"+d.id,img:photoForDoctor(d)}));
  SC.SPECIALITIES.forEach(s=>items.push({type:LANG==='ur'?'خصوصیت':'Speciality',label:specName(s),sub:s.count+" "+t('doctors_lc'),href:"#/doctors?speciality="+s.id}));
  SC.HOSPITALS.forEach(h=>items.push({type:LANG==='ur'?'ہسپتال':'Hospital',label:h.name,sub:h.city+" · "+h.type,href:"#/doctors?hospital="+h.id}));
  let idx=-1;
  function render(q){
    const term=q.trim().toLowerCase();
    if(!term){box.classList.remove("open");box.innerHTML="";return}
    const matches=items.filter(it=>it.label.toLowerCase().includes(term)||it.sub.toLowerCase().includes(term)).slice(0,8);
    if(!matches.length){box.innerHTML='<div class="ac__empty">'+(LANG==='ur'?'کوئی نتیجہ نہیں: ':'No results for ')+'"'+esc(q)+'"</div>';box.classList.add("open");return}
    const groups={};matches.forEach(m=>(groups[m.type]=groups[m.type]||[]).push(m));
    let html="";
    Object.keys(groups).forEach(g=>{
      html+='<div class="ac__group">'+g+"</div>";
      groups[g].forEach(m=>{
        const thumb=m.img?'<img src="'+esc(m.img)+'" alt="" style="width:26px;height:26px;border-radius:50%;object-fit:cover" loading="lazy"/>':'';
        html+='<a href="'+m.href+'" data-nav class="ac__item">'+thumb+'<span><strong>'+esc(m.label)+'</strong> <span class="dim">— '+esc(m.sub)+'</span></span></a>';
      });
    });
    box.innerHTML=html;
    box.classList.add("open");
    box.querySelectorAll(".ac__item").forEach(a=>on(a,"click",()=>{box.classList.remove("open");input.value=""}));
    idx=-1;
  }
  on(input,"input",debounce(e=>render(e.target.value),160));
  on(input,"focus",()=>{if(input.value.trim())render(input.value)});
  on(input,"keydown",e=>{
    const opts=$$(".ac__item",box);if(!opts.length)return;
    if(e.key==="ArrowDown"){e.preventDefault();idx=Math.min(idx+1,opts.length-1)}
    else if(e.key==="ArrowUp"){e.preventDefault();idx=Math.max(idx-1,0)}
    else if(e.key==="Enter"&&idx>=0){e.preventDefault();opts[idx].click();return}
    else if(e.key==="Escape"){box.classList.remove("open");return}
    else return;
    opts.forEach(o=>o.classList.remove("active"));
    if(idx>=0)opts[idx].classList.add("active");
  });
  on(document,"click",e=>{if(!input.parentElement.contains(e.target))box.classList.remove("open")});
}

document.addEventListener("click",e=>{
  if(e.target.closest("[data-nav]")){
    $$(".drawer.open").forEach(d=>d.classList.remove("open"));
    document.body.style.overflow="";
  }
  const saveBtn=e.target.closest("[data-save-doc]");
  if(saveBtn){
    e.preventDefault();
    const id=saveBtn.dataset.saveDoc;
    const saved=store.get("savedDoctors",[]);
    const i=saved.indexOf(id);
    if(i>-1){saved.splice(i,1);toast(t('toast_removed'),t('toast_msg_removed'),"info")}
    else{saved.push(id);toast(t('toast_saved'),t('toast_msg_saved'),"success")}
    store.set("savedDoctors",saved);
    updateSaveButtons();
    return;
  }
  const addBtn=e.target.closest("[data-add-cart]");
  if(addBtn){
    const id=addBtn.dataset.addCart;
    const cart=store.get("cart",[]);
    if(cart.includes(id)) toast(t('toast_added'),LANG==='ur'?'یہ آئٹم پہلے سے کارٹ میں ہے':'This item is already in your cart',"info");
    else{cart.push(id);store.set("cart",cart);toast(t('toast_added'),t('toast_msg_cart'),"success");renderCart();updateCartCount()}
    return;
  }
  const rem=e.target.closest("[data-remove-cart]");
  if(rem){
    const id=rem.dataset.removeCart;
    store.set("cart",store.get("cart",[]).filter(x=>x!==id));
    renderCart();updateCartCount();
    toast(t('toast_removed'),t('toast_msg_cart_rm'),"info");
    return;
  }
  if(e.target.closest("#cartBtn")){
    e.preventDefault();
    const cd=$("#cartDrawer");
    if(cd){cd.classList.add("open");document.body.style.overflow="hidden";renderCart();}
    return;
  }
  const cartClose=e.target.closest("[data-close-cart]");
  if(cartClose){
    const d=cartClose.closest(".drawer");
    if(d)d.classList.remove("open");
    document.body.style.overflow="";
    return;
  }
  if(e.target.closest("[data-open-drawer]")){
    const d=$("#drawer");
    if(d)d.classList.add("open");
    document.body.style.overflow="hidden";
    return;
  }
  const drawerClose=e.target.closest("[data-close-drawer]");
  if(drawerClose){
    const d=drawerClose.closest(".drawer");
    if(d)d.classList.remove("open");
    document.body.style.overflow="";
    return;
  }
});

