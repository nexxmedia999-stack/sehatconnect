function wireHomePage(){
  const form=$("#heroForm");
  if(!form) return;
  const tabs=$$(".searchbox__tab");
  const specInput=$("#heroSpec");
  const citySel=$("#heroCity");
  const placeholders={doctors:t('ph_speciality'),hospitals:t('tab_hospitals'),labs:t('tab_labs')};
  let mode="doctors";
  tabs.forEach(x=>on(x,"click",()=>{
    tabs.forEach(y=>y.setAttribute("aria-selected","false"));
    x.setAttribute("aria-selected","true");
    mode=x.dataset.search;
    if(specInput) specInput.placeholder=placeholders[mode];
  }));
  on(form,"submit",e=>{
    e.preventDefault();
    const q=(specInput&&specInput.value||"").trim();
    if(mode==="hospitals"){
      location.hash=q?"#/hospitals?city="+encodeURIComponent(citySel.value):"#/hospitals";
      return;
    }
    if(mode==="labs"){
      location.hash=q?"#/labs?q="+encodeURIComponent(q):"#/labs";
      return;
    }
    const sp=SC.SPECIALITIES.find(s=>s.name.toLowerCase()===q.toLowerCase()||s.id===q.toLowerCase());
    const doc=SC.DOCTORS.find(d=>d.name.toLowerCase().includes(q.toLowerCase())&&q.length>2);
    if(doc){ location.hash="#/doctor/"+doc.id; return; }
    const bits=[];
    if(citySel && citySel.value) bits.push("city="+encodeURIComponent(citySel.value));
    if(sp) bits.push("speciality="+sp.id);
    location.hash=bits.length?"#/doctors?"+bits.join("&"):"#/doctors";
  });
}

function wireTabs(){
  $$("[data-tabs]").forEach(group=>{
    const tabs=$$('[role="tab"]',group);
    tabs.forEach((tab,i)=>{
      tab.onclick=()=>{
        tabs.forEach(x=>x.setAttribute("aria-selected","false"));
        tab.setAttribute("aria-selected","true");
        const root=group.dataset.tabs;
        $$('[data-tabpanel="'+root+'"]').forEach(p=>p.classList.toggle("active",p.id===tab.getAttribute("aria-controls")));
        initReveal(); initCounters();
      };
      tab.onkeydown=e=>{
        let ni=null;
        if(e.key==="ArrowRight") ni=(i+1)%tabs.length;
        if(e.key==="ArrowLeft") ni=(i-1+tabs.length)%tabs.length;
        if(ni!==null){e.preventDefault();tabs[ni].focus();tabs[ni].click()}
      };
    });
  });
}
function wireAccordions(){
  $$(".acc__btn").forEach(btn=>{
    if(btn.dataset.wired) return;
    btn.dataset.wired="1";
    btn.onclick=()=>{
      const panel=btn.nextElementSibling;
      const open=btn.getAttribute("aria-expanded")==="true";
      const acc=btn.closest(".accordion");
      if(acc) $$(".acc__btn",acc).forEach(b=>{
        if(b!==btn){b.setAttribute("aria-expanded","false");b.nextElementSibling.style.height="0px"}
      });
      btn.setAttribute("aria-expanded",String(!open));
      panel.style.height=open?"0px":panel.scrollHeight+"px";
    };
  });
}
function wireStarPickers(){
