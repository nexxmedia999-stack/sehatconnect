  if(lang===LANG) return;
  setLang(lang);
  document.body.setAttribute("dir",lang==="ur"?"rtl":"ltr");
  document.documentElement.lang=lang==="ur"?"ur":"en";
  $$("[data-lang]").forEach(x=>x.classList.toggle("chip--active",x.dataset.lang===lang));
  setTimeout(()=>{
    initAutocomplete();
    const specs=$("#megaSpecs");
    if(specs) specs.innerHTML=SC.SPECIALITIES.slice(0,21).map(s=>
      '<a class="mega__link" href="#/doctors?speciality='+s.id+'" data-nav>'+I.heart+specName(s)+'</a>'
    ).join("");
    renderRoute();
  },50);
  toast(t('lang_switched'),lang==="ur"?t('lang_msg_ur'):t('lang_msg_en'),"success");
});

on($("#cityBtn"),"click",()=>{
  const cur=store.get("city","Karachi");
  const idx=Math.max(0,SC.CITIES.indexOf(cur));
  const next=SC.CITIES[(idx+1)%SC.CITIES.length];
  store.set("city",next);
  $("#cityLabel").textContent=next;
  toast(t('city_changed'),t('city_browsing')+next,"success");
});

on($("#checkoutBtn"),"click",()=>{
  const cart=store.get("cart",[]);
  if(!cart.length){toast(t('t_empty_cart'),t('t_empty_cart_d'),"error");return}
  toast(t('t_checkout'),t('t_checkout_d')+cart.length+(LANG==='ur'?' آئٹم(ز)':' item(s)'),"success");
  store.set("cart",[]);
  renderCart();updateCartCount();
  const cd=$("#cartDrawer");
  if(cd) cd.classList.remove("open");
  document.body.style.overflow="";
});

(function(){const y=$("#year");if(y) y.textContent=new Date().getFullYear();})();

on(window,"hashchange",renderRoute);

function boot(){
  document.body.setAttribute("dir",LANG==="ur"?"rtl":"ltr");
  document.documentElement.lang=LANG==="ur"?"ur":"en";
  $$("[data-lang]").forEach(x=>x.classList.toggle("chip--active",x.dataset.lang===LANG));
  applyStaticTranslations();
  renderRoute();
  initAutocomplete();
  const cl=$("#cityLabel");
  if(cl) cl.textContent=store.get("city","Karachi");
}
on(document,"DOMContentLoaded",boot);
if(document.readyState==="interactive"||document.readyState==="complete") boot();
</script>
</body>
</html>
