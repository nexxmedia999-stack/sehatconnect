/* Utilities */
const $ = (s,r=document)=>r.querySelector(s);
const $$ = (s,r=document)=>Array.from(r.querySelectorAll(s));
const on = (el,ev,fn,opts)=>{ if(el) el.addEventListener(ev,fn,opts); return el; };
const debounce = (fn,wait=200)=>{let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),wait)}};
const fmtPKR = n=>"PKR "+Number(n).toLocaleString("en-PK");
const initials = name=>name.replace(/^Dr\.?\s*/i,"").split(/\s+/).slice(0,2).map(w=>w[0]).join("").toUpperCase();
const esc = s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store = {
  get(k,fb){try{const v=JSON.parse(localStorage.getItem("sc_"+k));return v===null||v===undefined?fb:v}catch{return fb}},
  set(k,v){try{localStorage.setItem("sc_"+k,JSON.stringify(v))}catch{}},
  remove(k){try{localStorage.removeItem("sc_"+k)}catch{}}
};
const starsHTML = r=>{let h='<span class="stars" aria-hidden="true">';for(let i=1;i<=5;i++)h+=i<=Math.round(r)?I.star:I.starOutline;return h+'</span>'};

function applyStaticTranslations(){
  document.querySelectorAll("[data-i18n]").forEach(el=>{
    const k = el.dataset.i18n;
    const v = t(k);
    if(v) el.textContent = v;
  });
  document.querySelectorAll("[data-i18n-ph]").forEach(el=>{
    const k = el.dataset.i18nPh;
    const v = t(k);
    if(v) el.setAttribute("placeholder", v);
  });
}

function toast(title,msg,type="info"){
  const root=$("#toasts");
  if(!root) return;
  const map={success:I.checkCircle,error:I.x,info:I.shield};
  const el=document.createElement("div");
  el.className="toast toast--"+type;
  el.innerHTML='<span class="toast__ico">'+(map[type]||I.shield)+'</span><div><b>'+esc(title)+'</b>'+esc(msg||"")+'</div>';
  root.appendChild(el);
  setTimeout(()=>{el.classList.add("leaving");el.addEventListener("animationend",()=>el.remove(),{once:true})},3000);
}

function validateForm(form){
  let ok=true;
  $$("[required]",form).forEach(inp=>{
    const field=inp.closest(".field");const err=field&&field.querySelector(".field-error");
    let msg="";const v=(inp.value||"").trim();
    if(!v) msg=LANG==='ur'?"یہ فیلڈ لازمی ہے۔":"This field is required.";
    else if(inp.type==="email"&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) msg=LANG==='ur'?"درست ای میل درج کریں۔":"Enter a valid email.";
    else if(inp.type==="tel"&&!/^[0-9+\-\s()]{10,}$/.test(v)) msg=LANG==='ur'?"درست فون نمبر درج کریں۔":"Enter a valid phone number.";
    else if(inp.minLength&&v.length<inp.minLength) msg=LANG==='ur'?("کم از کم "+inp.minLength+" حروف۔"):("Minimum "+inp.minLength+" characters.");
    if(field) field.classList.toggle("invalid",!!msg);
    if(err) err.textContent=msg;
    if(msg) ok=false;
  });
  return ok;
}

document.addEventListener("pointerdown",e=>{
  const btn=e.target.closest(".btn, .icon-btn, .chip, .spec-card, .slot");
  if(!btn) return;
  const rect=btn.getBoundingClientRect();
  const size=Math.max(rect.width,rect.height);
  const ripple=document.createElement("span");
  ripple.className="ripple";
  ripple.style.width=ripple.style.height=size+"px";
  ripple.style.left=(e.clientX-rect.left-size/2)+"px";
  ripple.style.top=(e.clientY-rect.top-size/2)+"px";
  if(getComputedStyle(btn).position==="static") btn.style.position="relative";
  btn.appendChild(ripple);
  setTimeout(()=>ripple.remove(),700);
});

function animateCounter(el){
  const target=parseFloat(el.dataset.count||"0");
  const suffix=el.dataset.suffix||"";
  const decimals=parseInt(el.dataset.decimals||"0",10);
  const duration=1500;
  const start=performance.now();
  function frame(now){
    const p=Math.min(1,(now-start)/duration);
    const eased=1-Math.pow(1-p,3);
    const val=target*eased;
    el.textContent=(decimals?val.toFixed(decimals):Math.round(val).toLocaleString("en-PK"))+suffix;
    if(p<1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}
function initCounters(){
  const els=$$(".counter:not(.counted)");
  if(!els.length) return;
  if(!("IntersectionObserver" in window)){els.forEach(el=>{el.classList.add("counted");animateCounter(el)});return}
  const io=new IntersectionObserver(entries=>{
    entries.forEach(en=>{
      if(en.isIntersecting){en.target.classList.add("counted");animateCounter(en.target);io.unobserve(en.target);}
    });
  },{threshold:.4});
  els.forEach(el=>io.observe(el));
}

